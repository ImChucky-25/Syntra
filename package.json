{
  "name": "syntra",
  "version": "0.1.0",
  "private": true,
  "description": "Syntra — provider-neutral multi-model AI platform (Phase 1)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "vite": "^6.0.7"
  },
  "scripts": {
    "build": "npm run build --workspace @syntra/shared-types && npm run build --workspace @syntra/validation && npm run build --workspace @syntra/api && npm run build --workspace @syntra/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @syntra/api",
    "dev:api": "npm run dev --workspace @syntra/api",
    "dev:web": "npm run dev --workspace @syntra/web",
    "db:generate": "npm run db:generate --workspace @syntra/api",
    "db:migrate": "npm run db:migrate --workspace @syntra/api",
    "db:seed": "npm run db:seed --workspace @syntra/api",
    "smoke": "node infrastructure/smoke.mjs",
    "smoke:load": "node infrastructure/smoke.mjs --requests 200 --concurrency 20"
  }
}
