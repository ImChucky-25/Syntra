# AI Zone — environment configuration (copy to .env and adjust)

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL connection (local dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_zone

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_TTL_HOURS=72

# Frontend origin allowed to call the API with cookies
CORS_ORIGIN=http://localhost:5173

# AI providers — keys stay server-side only, never shipped to the browser
OPENAI_API_KEY=
# OPENAI_BASE_URL=            # optional: override for proxies/self-hosted gateways (Phase 2)
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=         # optional: override for proxies/self-hosted gateways (Phase 2)

# Model context budget (approximate characters per token for trimming history)
CONTEXT_CHARS_PER_TOKEN=4
CONTEXT_MAX_INPUT_TOKENS=12000
