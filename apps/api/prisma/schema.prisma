// AI Zone — Phase 1 database schema (spec §10)
// UUID PKs, timestamps, indexes, FK constraints per §10.3.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum MessageRole {
  SYSTEM
  USER
  ASSISTANT
}

enum FileStatus {
  PENDING
  READY
  FAILED
}

enum UsageSource {
  CHAT
  AGENT
  WORKFLOW
}

enum RunStatus {
  PENDING
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum ToolExecStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?
  displayName  String
  role         UserRole  @default(USER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions       Session[]
  conversations  Conversation[]
  usageRecords   UsageRecord[]
  preferences    UserPreference?
  agentRuns      AgentRun[]
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Conversation {
  id              String    @id @default(uuid())
  userId          String
  title           String    @default("New conversation")
  agentId         String?
  modelPreference String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
  usageRecords UsageRecord[]

  @@index([userId, updatedAt])
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  modelId        String?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AiProvider {
  id            String   @id @default(uuid())
  name          String   @unique
  adapterKey    String
  status        String   @default("active")
  configRef     String?
  enabled       Boolean  @default(true)
  models        AiModel[]
  createdAt     DateTime @default(now())
}

model AiModel {
  id               String   @id @default(uuid())
  providerId       String
  modelKey         String
  displayName      String
  capabilities     String[]
  contextWindow    Int      @default(8192)
  maxOutputTokens  Int      @default(4096)
  costPer1kInput   Decimal  @db.Decimal(10, 6) @default(0)
  costPer1kOutput  Decimal  @db.Decimal(10, 6) @default(0)
  enabled          Boolean  @default(true)
  version          Int      @default(1)
  createdAt        DateTime @default(now())

  provider     AiProvider    @relation(fields: [providerId], references: [id])
  usageRecords UsageRecord[]
  agentRuns    AgentRun[]

  @@unique([providerId, modelKey])
  @@index([enabled])
}

model UsageRecord {
  id           String      @id @default(uuid())
  userId       String
  modelId      String?
  conversationId String?
  inputTokens  Int         @default(0)
  outputTokens Int         @default(0)
  costAmount   Decimal     @db.Decimal(12, 6) @default(0)
  source       UsageSource @default(CHAT)
  createdAt    DateTime    @default(now())

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  model         AiModel?   @relation(fields: [modelId], references: [id])
  conversation  Conversation? @relation(fields: [conversationId], references: [id])

  @@index([userId, createdAt])
  @@index([modelId])
}

model File {
  id         String     @id @default(uuid())
  userId     String
  storageKey String
  mimeType   String
  sizeBytes  Int
  status     FileStatus @default(PENDING)
  createdAt  DateTime   @default(now())

  @@index([userId])
}

model UserPreference {
  userId         String   @id
  defaultModelKey String?
  theme          String   @default("dark")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Versioned agent configuration (spec §7, §10.2)
model Agent {
  id           String   @id @default(uuid())
  key          String   @unique
  name         String
  version      Int      @default(1)
  instructions String   @db.Text
  /// { allow: string[], requireApproval: string[], maxToolCalls, timeoutMs }
  toolPolicy   Json
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  runs AgentRun[]
}

model AgentRun {
  id              String    @id @default(uuid())
  userId          String
  agentId         String
  /// Agent.version snapshot at run creation (spec §10.3 versioning)
  agentVersion    Int       @default(1)
  status          RunStatus @default(PENDING)
  input           String    @db.Text
  output          String?   @db.Text
  modelId         String?
  inputTokens     Int       @default(0)
  outputTokens    Int       @default(0)
  error           String?   @db.Text
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  /// cooperative cancellation flag, checked between steps (spec §7.1)
  cancelRequested Boolean   @default(false)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent          Agent           @relation(fields: [agentId], references: [id])
  model          AiModel?        @relation(fields: [modelId], references: [id])
  toolExecutions ToolExecution[]

  @@index([userId, startedAt])
  @@index([status])
}

model ToolExecution {
  id             String         @id @default(uuid())
  runId          String
  toolName       String
  input          Json
  output         Json?
  status         ToolExecStatus @default(PENDING)
  approvalStatus ApprovalStatus @default(NOT_REQUIRED)
  durationMs     Int?
  error          String?        @db.Text
  createdAt      DateTime       @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}
